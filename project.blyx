use std::cli;
use console;
use cormorant;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Separate variation in packet delivery from a constant difference between clocks.");
        println!("Usage: cormorant sent arrived initial");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = cormorant_trace([0, 16], [100, 148], 0.0);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let sent = console_vector(args_at(argv, 0));
        let arrived = console_vector(args_at(argv, 1));
        let initial = console_value(args_at(argv, 2));
        result = cormorant_trace(sent, arrived, initial);
    }
    if len(result) == 0 { stderr_line("Invalid input for Cormorant. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
